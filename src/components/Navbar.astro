---
import { nav, navAll } from '../data/site';
interface Props { contactHref?: string }
// Las páginas legales, 404 y gracias no tienen sección de contacto: su CTA va a la home.
const { contactHref = '/#contacto' } = Astro.props;
// build.format:'file' entrega /calidad.html: se normaliza para marcar la página activa.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/(index)?$/, '') || '/';
---
<header class="sticky top-0 z-40 border-b border-ink-100/80 bg-ink-50/85 backdrop-blur-md">
  <nav class="container-x flex items-center gap-4 py-3" aria-label="Principal">
    <a href="/" class="h-display shrink-0 text-[1.05rem] font-semibold tracking-tight text-ink-950">
      Natanael&nbsp;Alzate
    </a>

    <ul class="ml-auto hidden items-center gap-1 lg:flex">
      {nav.map(n => (
        <li>
          <a
            href={n.href}
            aria-current={path === n.href ? 'page' : undefined}
            class:list={[
              'rounded-sm px-2.5 py-1.5 text-[0.86rem] font-medium transition-colors',
              path === n.href
                ? 'bg-brand-500/12 text-brand-700'
                : 'text-ink-600 hover:bg-ink-100 hover:text-ink-950',
            ]}
          >{n.label}</a>
        </li>
      ))}
    </ul>

    <a href={contactHref} class="btn btn-primary ml-auto text-[0.85rem] lg:ml-2">Hablemos</a>

    <details class="relative lg:hidden">
      <summary class="list-none rounded-sm p-2 text-ink-700 hover:bg-ink-100" aria-label="Abrir menú">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </summary>
      <ul class="absolute right-0 top-11 w-60 rounded-lg border border-ink-100 bg-white p-2 shadow-lg">
        {navAll.map(n => (
          <li>
            <a
              href={n.href}
              aria-current={path === n.href ? 'page' : undefined}
              class:list={[
                'block rounded-sm px-3 py-2 text-[0.9rem]',
                path === n.href ? 'bg-brand-500/12 font-semibold text-brand-700' : 'text-ink-700 hover:bg-ink-50',
              ]}
            >{n.label}</a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>
