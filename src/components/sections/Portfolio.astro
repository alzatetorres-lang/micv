---
import { projects, type Project } from '../../data/content';
import Shot from '../Shot.astro';
import ChapterLabel from '../ChapterLabel.astro';
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
const live = (p: Project) => p.status === 'En producción';
// Home: Stacking Cards (Daniel Petho, 21st.dev) portado. Cada proyecto se fija
// y el siguiente se apila encima; las anteriores se reducen (story.ts).
---
<section id="trabajo" data-chapter="Proyectos" class="container-x py-20 md:py-28">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <ChapterLabel title="Proyectos" />
      <h2 class="h-section mt-3 text-ink-950">{detailed ? 'Proyecto a proyecto' : 'Seis webs, seis historias'}</h2>
    </div>
    <p class="max-w-[44ch] text-[0.95rem] leading-relaxed text-ink-600">
      {projects.length} webs publicadas. Cada ficha enlaza a la web real: el resultado se comprueba, no se cuenta.
    </p>
  </div>

  {detailed ? (
    <div class="mt-12 flex flex-col gap-20">
      {projects.map((p, i) => (
        <article id={p.slug} class="reveal grid gap-8 md:grid-cols-2 md:items-start md:gap-12">
          <Shot project={p} aspect="aspect-[4/5]" class:list={['md:sticky md:top-24', i % 2 === 1 && 'md:order-2']} />

          <div class:list={[i % 2 === 1 && 'md:order-1']}>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.74rem] uppercase tracking-[0.12em] text-brand-600">
              <span>{p.sector}</span>
              <span class:list={['inline-flex items-center gap-1.5', live(p) ? 'text-success-600' : 'text-gold-600']}>
                <span class:list={['h-1.5 w-1.5 rounded-full', live(p) ? 'bg-success-500' : 'bg-gold-500']} aria-hidden="true"></span>
                {p.status}
              </span>
            </p>
            <h3 class="h-display mt-2 text-[1.5rem] font-semibold text-ink-950">{p.name}</h3>

            <dl class="mt-5 flex flex-col gap-4 text-[0.94rem] leading-relaxed">
              <div><dt class="font-semibold text-ink-800">Reto</dt><dd class="mt-0.5 text-ink-600">{p.reto}</dd></div>
              <div><dt class="font-semibold text-ink-800">Solución</dt><dd class="mt-0.5 text-ink-600">{p.solucion}</dd></div>
              {p.destacados && (
                <div>
                  <dt class="font-semibold text-ink-800">Qué incluye</dt>
                  <dd class="mt-1.5">
                    <ul class="flex flex-col gap-2 text-ink-600">
                      {p.destacados.map(d => (
                        <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2 before:bg-brand-500">{d}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )}
              <div><dt class="font-semibold text-ink-800">Stack</dt><dd class="mt-0.5 text-ink-600">{p.stack}</dd></div>
              <div><dt class="font-semibold text-ink-800">Resultado</dt><dd class="mt-0.5 border-l-2 border-brand-200 pl-3 text-ink-700">{p.resultado}</dd></div>
            </dl>

            <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tecnologías">
              {p.tags.map(t => <li class="chip">{t}</li>)}
            </ul>
            {p.proximamente
              ? <p class="mt-6 font-mono text-[0.78rem] text-ink-400">Próximamente en {new URL(p.url).host}</p>
              : <a href={p.url} rel="noopener" class="btn btn-ghost mt-6 text-[0.85rem]">Ver web publicada ↗</a>}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="stack mt-14" data-stack>
      {projects.map((p, i) => (
        <div class="stack-item" style={`--i:${i}`}>
          <article id={p.slug} class="stack-card" data-stack-card style={`--accent:${p.accent}`}>
            <div class="stack-copy">
              <p class="flex items-center justify-between gap-4 font-mono text-[0.72rem] uppercase tracking-[0.12em]">
                <span class="stack-accent">{p.sector}</span>
                <span class="tabular-nums text-ink-400">{String(i + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span>
              </p>
              <h3 class="h-display mt-4 text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-[1.05] tracking-[-0.02em] text-ink-950">{p.name}</h3>
              <p class:list={['mt-2 inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-[0.12em]', live(p) ? 'text-success-600' : 'text-gold-600']}>
                <span class:list={['h-1.5 w-1.5 rounded-full', live(p) ? 'bg-success-500 dot-live' : 'bg-gold-500']} aria-hidden="true"></span>{p.status}
              </p>
              <p class="mt-4 max-w-[48ch] text-[0.96rem] leading-relaxed text-ink-600">{p.resumen}</p>
              {i === 0 && p.destacados && (
                <ul class="mt-4 hidden flex-col gap-2 text-[0.88rem] leading-relaxed text-ink-700 lg:flex">
                  {p.destacados.slice(0, 2).map(d => (
                    <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2 before:bg-[var(--accent)]">{d}</li>
                  ))}
                </ul>
              )}
              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tecnologías">
                {p.tags.map(t => <li class="chip">{t}</li>)}
              </ul>
              <p class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-6 text-[0.88rem] font-medium">
                {p.proximamente
                  ? <span class="text-ink-400">Próximamente en {new URL(p.url).host}</span>
                  : <a href={p.url} rel="noopener" class="btn btn-primary text-[0.84rem]">Ver web publicada ↗</a>}
                <a href={`/casos#${p.slug}`} class="link-underline text-ink-700">Caso completo</a>
              </p>
            </div>
            <Shot project={p} aspect="aspect-[4/3]" class="stack-shot" />
          </article>
        </div>
      ))}

      <div class="stack-item" style={`--i:${projects.length}`}>
        <aside class="stack-card stack-cta" data-stack-card style="--accent:#1796A3">
          <div class="stack-copy">
            <p class="font-mono text-[0.72rem] uppercase tracking-[0.12em] stack-accent">Siguiente proyecto</p>
            <p class="h-display mt-4 text-[clamp(2rem,4vw,3.2rem)] font-semibold leading-[1.02] tracking-[-0.025em] text-ink-950">¿El séptimo es <span class="text-gradient">el tuyo</span>?</p>
            <p class="mt-4 max-w-[46ch] text-[0.98rem] leading-relaxed text-ink-600">
              Cuéntame qué tiene que conseguir tu web —reservas, contactos, catálogo o captación B2B— y te digo cómo la plantearía, con qué tecnología y en qué plazo.
            </p>
            <p class="mt-auto flex flex-wrap gap-3 pt-7">
              <a href="#contacto" class="btn btn-primary">Contar mi proyecto</a>
              <a href="/casos" class="btn btn-ghost">Ver todos los casos</a>
            </p>
          </div>
          <div class="stack-cta-art" aria-hidden="true">
            <span>07</span>
          </div>
        </aside>
      </div>
    </div>
  )}
</section>
