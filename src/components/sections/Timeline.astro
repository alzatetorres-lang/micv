---
import { timeline, formacion } from '../../data/content';
import { facts } from '../../data/site';
---
<section id="trayectoria" class="border-y border-ink-100 bg-white/50">
  <div class="container-x py-20 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="h-section max-w-[22ch] text-ink-950">Trayectoria desde {facts.anosDesde}</h2>
      <p class="max-w-[40ch] text-[0.95rem] leading-relaxed text-ink-600">
        Del backend de televisión interactiva en Praga al aula y a la consultoría. Desde 2017 sin salir del terreno técnico.
      </p>
    </div>

    <ol class="nx-tl mt-12 flex flex-col gap-10">
      {timeline.map(t => (
        <li class="reveal relative grid gap-3 pl-9 md:grid-cols-[9.5rem_1fr] md:gap-9 md:pl-11">
          <span class="nx-tl-dot" aria-hidden="true"></span>
          <div>
            <p class="font-mono text-[0.78rem] tabular-nums text-brand-600">{t.years}</p>
            <p class="mt-1 text-[0.82rem] font-medium text-ink-400">{t.org}</p>
          </div>
          <div class="max-w-[66ch]">
            <h3 class="h-display text-[1.05rem] font-semibold text-ink-950">{t.role}</h3>
            <p class="mt-2 text-[0.94rem] leading-relaxed text-ink-600">{t.body}</p>
            <p class="mt-2.5 border-l-2 border-brand-200 pl-3 text-[0.9rem] leading-relaxed text-ink-700">{t.result}</p>
          </div>
        </li>
      ))}
    </ol>

    <h3 class="h-display mt-16 text-[1.15rem] font-semibold text-ink-950">Formación y acreditaciones</h3>
    <dl class="mt-6 grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {formacion.map(f => (
        <div class="border-t border-ink-200 pt-4">
          <dt class="flex items-baseline gap-3">
            <span class="shrink-0 font-mono text-[0.75rem] tabular-nums text-brand-600">{f.year}</span>
            <span class="h-display text-[0.98rem] font-semibold text-ink-950">{f.title}</span>
          </dt>
          <dd class="mt-1.5 max-w-[52ch] text-[0.9rem] leading-relaxed text-ink-600">{f.detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .nx-tl { position: relative; }
  .nx-tl::before {
    content: "";
    position: absolute;
    top: .55rem;
    bottom: .55rem;
    left: 5px;
    width: 2px;
    background: linear-gradient(to bottom,
      transparent 0,
      var(--color-brand-300) 6%,
      var(--color-brand-500) 50%,
      var(--color-brand-300) 94%,
      transparent 100%);
  }
  .nx-tl-dot {
    position: absolute;
    left: 0;
    top: .45rem;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--color-ink-50);
    border: 2px solid var(--color-brand-500);
  }
  @media (min-width: 768px) {
    .nx-tl::before { left: 5px; }
  }
</style>
