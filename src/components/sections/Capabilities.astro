---
import { capabilities } from '../../data/content';
import ChapterLabel from '../ChapterLabel.astro';
// Sticky Scroll Reveal (Aceternity, 21st.dev) portado al scroll de la página:
// a la izquierda cada capacidad se enciende al pasar por el centro; a la derecha
// un panel fijo muestra sus herramientas y la evidencia. En móvil, lista simple.
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="capacidades" data-chapter="Capacidades" data-sticky-reveal class="relative border-y border-ink-100 bg-white/50">
  <div class="container-x py-20 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <ChapterLabel title="Capacidades" />
        <h2 class="h-section mt-3 max-w-[22ch] text-ink-950">Capacidades, con la prueba al lado</h2>
      </div>
      <p class="max-w-[46ch] text-[0.95rem] leading-relaxed text-ink-600">
        Qué sé hacer, con qué herramientas y dónde comprobarlo: cada línea remite a un proyecto publicado,
        una acreditación o una experiencia concreta.
      </p>
    </div>

    <div class="mt-14 lg:grid lg:grid-cols-[1fr_1fr] lg:gap-16">
      <ol class="flex flex-col gap-6 lg:gap-0">
        {capabilities.map((c, i) => (
          <li data-sr-item class="sr-item reveal rounded-2xl border border-ink-100 bg-ink-50 p-6 lg:flex lg:min-h-[62svh] lg:flex-col lg:justify-center lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0">
            <span class="font-mono text-[0.8rem] tabular-nums text-brand-600">{pad(i + 1)} / {pad(capabilities.length)}</span>
            <h3 class="h-display mt-3 text-[clamp(1.35rem,2.6vw,2.2rem)] font-semibold leading-[1.08] tracking-[-0.02em] text-ink-950" style="text-wrap:balance">{c.title}</h3>
            <p class="mt-3 max-w-[46ch] text-[1rem] leading-relaxed text-ink-600">{c.body}</p>

            <!-- Detalle en línea: móvil, tablet y cualquier pantalla sin animaciones -->
            <div class="sr-inline mt-5 grid gap-5 sm:grid-cols-2">
              <div>
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-400">Herramientas</p>
                <ul class="mt-2.5 flex flex-wrap gap-1.5">
                  {c.skills.map(s => <li class="rounded-sm border border-ink-200 bg-white px-2 py-0.5 text-[0.78rem] text-ink-700">{s}</li>)}
                </ul>
              </div>
              <div>
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-400">Dónde se ve</p>
                <ul class="mt-2.5 flex flex-col gap-1.5 text-[0.88rem] leading-snug">
                  {c.evidence.map(e => (
                    <li>{e.href
                      ? <a href={e.href} class="link-underline text-brand-700">{e.label}</a>
                      : <span class="text-ink-700">{e.label}</span>}</li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <!-- Escritorio con animaciones: panel fijo que cambia con la capacidad activa -->
      <div class="sr-panel-wrap">
        <div class="sr-panel" data-sr-panel>
          <span class="sr-panel-num" aria-hidden="true" data-sr-count>01</span>
          {capabilities.map((c, i) => (
            <div data-sr-slide class:list={['sr-slide', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'} inert={i !== 0}>
              <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-white/60">Herramientas</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {c.skills.map((s, k) => <li class="sr-chip" style={`--k:${k}`}>{s}</li>)}
              </ul>
              <p class="mt-8 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-white/60">Dónde se ve</p>
              <ul class="mt-3 flex flex-col gap-2.5">
                {c.evidence.map((e, k) => (
                  <li class="sr-evidence" style={`--k:${k + 3}`}>
                    {e.href
                      ? <a href={e.href} class="text-white underline decoration-white/30 underline-offset-4 hover:decoration-white">{e.label} →</a>
                      : <span class="text-white/90">{e.label}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
