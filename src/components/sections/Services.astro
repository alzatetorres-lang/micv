---
import type { Service } from '../../data/content';
import ChapterLabel from '../ChapterLabel.astro';
interface Props { heading?: string; items: Service[]; note?: string; id?: string }
const { heading = 'Cómo puedo ayudarte', items, note, id = 'servicios' } = Astro.props;
---
{items.length > 0 && (
<section id={id} data-chapter="Servicios" class="container-x pt-20 pb-20 md:pt-28 md:pb-24">
  <ChapterLabel title="Servicios" />
  <h2 class="h-section mt-3 max-w-[24ch] text-ink-950">{heading}</h2>

  <!-- Lista numerada asimétrica; el borde se ilumina bajo el cursor (Card Spotlight) -->
  <ol class="mt-12 flex flex-col gap-3">
    {items.map((s, i) => (
      <li data-spotlight class:list={['spot reveal grid gap-4 rounded-2xl p-7 md:grid-cols-[4.5rem_1fr_1.15fr] md:items-start md:gap-8 md:p-9', `reveal-delay-${Math.min(i + 1, 4)}`]}>
        <span class="h-display text-[2rem] font-semibold leading-none tabular-nums text-brand-500/70">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="h-display text-[1.12rem] font-semibold leading-snug text-ink-950" style="text-wrap:balance">{s.title}</h3>
        <p class="max-w-[62ch] text-[0.96rem] leading-relaxed text-ink-600">{s.body}</p>
      </li>
    ))}
  </ol>

  {note && (
    <p class="mt-8 max-w-[68ch] border-l-2 border-brand-300 pl-5 text-[0.98rem] leading-relaxed text-ink-700">
      {note}
    </p>
  )}
</section>
)}
