---
import type { Profile } from '../../data/content';
import { site } from '../../data/site';
interface Props { profile: Profile }
const { profile: p } = Astro.props;
// id="home" en la portada: destino de los créditos «Desarrollado por Nathan Torres» de las webs de clientes.
---
<section id={p.slug === 'home' ? 'home' : undefined} class="relative overflow-hidden border-b border-ink-100">
  <div class="container-x grid gap-12 py-16 md:py-24 lg:grid-cols-[1.55fr_1fr] lg:items-end">
    <div class="max-w-[46ch] lg:max-w-none">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 class="h-display mt-5 text-[clamp(2rem,5.2vw,3.4rem)] font-semibold leading-[1.06] tracking-[-0.02em] text-ink-950" style="text-wrap:balance">
        {p.h1}
      </h1>
      <div class="mt-7 flex max-w-[64ch] flex-col gap-4 text-[1.03rem] leading-relaxed text-ink-600">
        {p.intro.map(t => <p>{t}</p>)}
      </div>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={p.ctaPrimary.href} class="btn btn-primary">{p.ctaPrimary.label}</a>
        {p.ctaSecondary && <a href={p.ctaSecondary.href} class="btn btn-ghost">{p.ctaSecondary.label}</a>}
      </div>
      {p.stats && (
        <dl class="mt-10 grid max-w-[42rem] grid-cols-2 gap-x-8 gap-y-5 border-t border-ink-100 pt-6 sm:grid-cols-4">
          {p.stats.map(s => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-[0.8rem] leading-snug text-ink-600">{s.label}</dt>
              <dd class="h-display text-[1.7rem] font-semibold tabular-nums text-ink-950">{s.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <!-- Bloque-tesis desplazado: rompe la simetría del hero centrado -->
    <aside class="relative lg:-mb-6">
      <div class="flex items-start gap-4 rounded-xl rounded-tl-sm border border-ink-100 bg-white/70 p-5 shadow-sm md:p-6">
        <img
          src={site.photo} alt={site.name}
          width="200" height="200" loading="eager" decoding="async" fetchpriority="high"
          class="h-16 w-16 shrink-0 rounded-lg rounded-br-sm border border-ink-100 object-cover md:h-20 md:w-20"
        />
        <div>
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-brand-600">Por qué yo</p>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-800">{p.claim}</p>
        </div>
      </div>
    </aside>
  </div>
</section>
