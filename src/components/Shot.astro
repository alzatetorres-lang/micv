---
import type { Project } from '../data/content';
interface Props {
  project: Project;
  /** Clase de proporción del marco, p. ej. aspect-[3/2]. */
  aspect?: string;
  class?: string;
}
const { project: p, aspect = 'aspect-[3/2]', class: extra } = Astro.props;
// Captura enmarcada como ventana de navegador: el dominio real queda a la vista.
// En escritorio, al pasar el ratón la captura se desplaza y muestra la página entera (.shot).
const host = new URL(p.url).host;
// width/height coherentes con el marco para reservar el hueco sin saltos de maquetación.
const [rw, rh] = (aspect.match(/\[(\d+)\/(\d+)\]/)?.slice(1) ?? ['3', '2']).map(Number);
const w = 960;
const h = Math.round((w * rh) / rw);
---
<a
  href={p.url}
  rel="noopener"
  aria-label={`Abrir ${p.name} (${host})`}
  class:list={['group block overflow-hidden rounded-xl border border-ink-100 bg-white shadow-sm transition-shadow hover:shadow-md', extra]}
>
  <span class="flex items-center gap-1.5 border-b border-ink-100 bg-ink-50 px-3 py-2" aria-hidden="true">
    <span class="h-2 w-2 rounded-full bg-ink-200"></span>
    <span class="h-2 w-2 rounded-full bg-ink-200"></span>
    <span class="h-2 w-2 rounded-full bg-ink-200"></span>
    <span class="ml-2 truncate font-mono text-[0.7rem] text-ink-400">{host}</span>
  </span>
  <img
    src={p.img}
    alt={`Captura de la web ${p.name}`}
    width={w} height={h} loading="lazy" decoding="async"
    class:list={['shot w-full object-cover', aspect]}
  />
</a>
