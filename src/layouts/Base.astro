---
import '../styles/global.css';
import { site } from '../data/site';
import { timeline, formacion } from '../data/content';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollFX from '../components/ScrollFX.astro';

interface Props {
  title?: string;
  description?: string;
  /** Deja el JSON-LD de Person solo en la home para no duplicar la entidad. */
  personSchema?: boolean;
  /** La página incluye la sección #contacto (las de perfil sí; legales, 404 y gracias no). */
  hasContact?: boolean;
}

const {
  title = `${site.name} · ${site.role}`,
  description = 'Analista programador y docente técnico acreditado por el SEPE. Desarrollo web, automatización con IA, gestión de formación FUNDAE y FOCO, y sistemas de calidad. Cuenca y remoto.',
  personSchema = false,
  hasContact = false,
} = Astro.props;
const contactHref = hasContact ? '#contacto' : '/#contacto';

/* NC-01 / NC-02: canonical y og:url siempre contra Astro.site,
   que astro.config.mjs fija en https://natanaelalzatetorres.com
   Con build.format:'file' el pathname llega como /calidad.html; Vercel
   sirve /calidad gracias a cleanUrls, así que el canonical debe ir sin .html */
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const canonical = new URL(cleanPath, Astro.site).toString();
const ogImage = new URL(site.ogImage, Astro.site).toString();

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Cuenca', addressRegion: 'Castilla-La Mancha', addressCountry: 'ES' },
  url: site.url,
  image: new URL(site.photo, Astro.site).toString(),
  /* NC-05 / NC-07: solo perfiles verificados y con contenido. */
  sameAs: [site.linkedin],
  knowsAbout: [
    'Desarrollo web con Next.js, React y Astro',
    'SEO técnico y datos estructurados',
    'Docencia en Formación Profesional para el Empleo',
    'Programación Java',
    'Bases de datos SQL',
    'Gestión de plataformas LMS Moodle',
    'Justificación FUNDAE y FOCO',
    'Calidad y mejora continua',
    'Automatización de procesos con IA',
  ],
  knowsLanguage: [
    { '@type': 'Language', name: 'Español', alternateName: 'es' },
    { '@type': 'Language', name: 'Inglés', alternateName: 'en' },
    { '@type': 'Language', name: 'Alemán', alternateName: 'de' },
  ],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Castilla-La Mancha' },
  hasCredential: formacion.map(f => ({
    '@type': 'EducationalOccupationalCredential',
    name: f.title,
    description: f.detail,
  })),
  worksFor: { '@type': 'Organization', name: timeline[0].org },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Cuenca' },
    { '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
  ],
};

const webpage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'es-ES',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
};
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- NC-10 -->
    <meta name="theme-color" content="#F2F7F9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1E2A" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Arma las animaciones solo si hay JS: sin JS, todo el contenido se ve igual. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-on');
      }
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(webpage)} />
    {personSchema && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>

  <body class="bg-grain">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded focus:bg-ink-950 focus:px-4 focus:py-2 focus:text-white">Saltar al contenido</a>
    <Navbar contactHref={contactHref} />
    <main id="main" class="nx-page">
      <slot />
    </main>
    <Footer contactHref={contactHref} />
    <ScrollFX />
    <!-- Raíl de capítulos: lo construye story.ts a partir de [data-chapter] -->
    <nav class="story-rail" aria-label="Capítulos de la página" data-rail hidden></nav>
    <script>
      import 'lenis/dist/lenis.css';
      import { initReveal } from '../scripts/reveal';
      import { initScrollFX } from '../scripts/scrollfx';
      import { initStory } from '../scripts/story';
      initReveal();
      initScrollFX();
      initStory();
      document.body.classList.add('has-loaded');
    </script>
  </body>
</html>
